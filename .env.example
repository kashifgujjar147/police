# SmartForce 360 — environment configuration. Copy to .env and fill in. Never commit real values.
# The service refuses to start in production when a required value is missing or unsafe.

NODE_ENV=production                 # development | test | production
PORT=8080
HOST=0.0.0.0
PUBLIC_URL=https://smartforce.example.org   # must be https in production; used in emailed links
CORS_ORIGINS=https://smartforce.example.org # comma-separated list of allowed web origins
TRUST_PROXY=true                    # true when behind a reverse proxy that sets X-Forwarded-For

# Storage
STORE=mongo                         # mongo (production) | file (single-node dev/pilot) | memory (tests)
MONGO_URL=mongodb://mongo:27017/?replicaSet=rs0
MONGO_DB=smartforce360
DATA_DIR=/var/lib/smartforce360     # file store data and uploaded files (use object storage in larger deployments)

# Secrets — generate with: npm run secrets   (prints fresh values; store them in your secret manager)
JWT_KEYS_JSON=[{"kid":"k1","privatePem":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","publicPem":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"}]
JWT_ACTIVE_KID=k1
FIELD_ENC_KEY=                      # 32 random bytes, base64 (AES-256-GCM for encrypted fields)
JOB_HMAC_KEY=                       # ≥ 32 chars (signs queued job payloads)
FILE_URL_KEY=                       # ≥ 32 chars (signs short-lived download links)
METRICS_TOKEN=                      # bearer token for /metrics; empty = /metrics disabled

# Password hashing: scrypt (built in) or argon2id (requires the optional "argon2" package)
PASSWORD_ALGO=scrypt
SCRYPT_N=32768
SCRYPT_P=3

# Platform super admin created on first start if it does not exist (MFA enrolment is forced at first sign-in)
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# Email (optional). Plain SMTP to your relay. In-app notifications work without it.
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM=no-reply@smartforce.example.org

# Process roles
WORKER_IN_PROCESS=false             # true: API also runs the worker (single node); false: run `npm run worker` separately
RATE_LIMITS=on
LOG_LEVEL=info
DEMO_MODE=false                     # refused in production
WEB_DIR=./apps/web/dist

# MFA. Keep true (or unset) everywhere except a developer's own machine.
# AUTH_MFA_REQUIRED=false skips the second factor at sign-in ONLY when NODE_ENV=development (both explicit);
# it is ignored in test and refused at startup in production. Passwords, lockout and RBAC are unaffected.
AUTH_MFA_REQUIRED=true
# Temporary: AUTH_MFA_LOGIN_DISABLED=true skips ONLY the second factor at sign-in (works in production; logged as a warning
# at startup and audited per sign-in). Lockout and Platform setup/invitation codes stay enforced. Remove to restore MFA.
# AUTH_MFA_LOGIN_DISABLED=true
